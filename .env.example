# Copy this to .env.local for local development
# Then fill in your actual Supabase credentials

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service key required for config writes (upsert). Get from Supabase > Settings > API
SUPABASE_SERVICE_KEY=your-service-role-key-here
WNCORE_ADMIN_TOKEN=WNCORE_ADMIN
# Groq API key for the live chat support feature (api/chat.js)
# Get from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
