{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/config.js": { "maxDuration": 10 },
    "api/chat.js":   { "maxDuration": 10 },
    "api/upload.js": { "maxDuration": 10 },
    "api/user.js":   { "maxDuration": 10 },
    "api/icy.js":    { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-admin-token" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security",  "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options",            "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy",    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; connect-src *; media-src *; img-src * data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:" },
        { "key": "Permissions-Policy",         "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/chat",   "dest": "/api/chat.js"   },
    { "src": "/api/upload", "dest": "/api/upload.js" },
    { "src": "/api/user",   "dest": "/api/user.js"   },
    { "src": "/api/icy",    "dest": "/api/icy.js"    },
    { "src": "/(.*)",       "dest": "/$1"            }
  ]
}
